<section class="page-header">
  <h1>Edit Client</h1>
</section>

<form method="post" action="/clients/<%= client.id %>" class="form">
  <label>Name
    <input type="text" name="name" value="<%= client.name %>" required>
  </label>
  <label>Email
    <input type="email" name="email" value="<%= client.email || '' %>">
  </label>
  <label>Phone
    <input type="text" name="phone" value="<%= client.phone || '' %>">
  </label>
  <label>Company
    <input type="text" name="company" value="<%= client.company || '' %>">
  </label>
  <label>Notes
    <textarea name="notes" rows="4"><%= client.notes || '' %></textarea>
  </label>
  <button type="submit" class="btn-primary">Save Changes</button>
</form>

<form method="post" action="/clients/<%= client.id %>/delete" onsubmit="return confirm('Delete this client?');">
  <button type="submit" class="btn-danger">Delete Client</button>
</form>