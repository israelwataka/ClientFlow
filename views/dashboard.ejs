<section class="page-header">
  <h1>Dashboard</h1>
  <p>Overview of clients, projects, requests, and payments.</p>
</section>

<section class="stats-grid">
  <div class="stat-card">
    <h2><%= stats.clientCount %></h2>
    <p>Clients</p>
  </div>
  <div class="stat-card">
    <h2><%= stats.projectCount %></h2>
    <p>Projects</p>
  </div>
  <div class="stat-card">
    <h2><%= stats.openRequests %></h2>
    <p>Open Requests</p>
  </div>
  <div class="stat-card">
    <h2><%= stats.pendingPayments %></h2>
    <p>Pending Payments</p>
  </div>
  <div class="stat-card">
    <h2><%= stats.overduePayments %></h2>
    <p>Overdue Payments</p>
  </div>
  <div class="stat-card">
    <h2><%= stats.upcomingRequests %></h2>
    <p>Requests due in 7 days</p>
  </div>
</section>